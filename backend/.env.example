HOST=0.0.0.0
PORT=3056
DATA_DIR=./data
DATABASE_URL=./data/dockpot.db
RUST_LOG=info
LOG_FORMAT=pretty
TIMEZONE=Europe/Madrid

# ── Autenticación OIDC (opcional) ─────────────────────────────
# Si no se configuran, Dockpot arranca en modo dev sin autenticación.
# Las rutas protegidas estarán accesibles sin login.
# Para producción, configura las tres variables:
#
# OIDC_ISSUER_URL=https://auth.tudominio.com
# OIDC_CLIENT_ID=dockpot
# OIDC_CLIENT_SECRET=xxxx
# OIDC_REDIRECT_URL=http://localhost:3056/auth/callback